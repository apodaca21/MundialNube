{
  "uid": "mundial-v3-performance",
  "title": "MundialNube v3 - API, PostgreSQL y replicas",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL y HTTP: p95 de la misma ventana",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"mundial-api\",endpoint!=\"/metrics\",endpoint!=\"/health\",endpoint!=\"/ready\"}[$__rate_interval])))",
          "legendFormat": "HTTP p95",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(mundial_database_command_duration_seconds_bucket{job=\"mundial-api\",provider=\"postgresql\"}[$__rate_interval])))",
          "legendFormat": "PostgreSQL p95",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "HTTP incluye la petición completa; PostgreSQL mide comandos EF reales, incluyendo red/materialización según el interceptor. Un request puede ejecutar varios comandos. No restar ambos percentiles."
    },
    {
      "id": 2,
      "title": "Solicitudes por Pod",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(http_requests_received_total{job=\"mundial-api\",endpoint!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Fallos HTTP por Pod",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(http_requests_received_total{job=\"mundial-api\",code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Comandos de base de datos por segundo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(mundial_database_command_duration_seconds_count{job=\"mundial-api\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} / {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Pods disponibles para Prometheus",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"mundial-api\"})",
          "legendFormat": "Pods",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "tags": [
    "mundialnube",
    "v3",
    "performance"
  ]
}

{
  "uid": "mundial-nube",
  "title": "MundialNube · Torneos y campeones",
  "description": "Monitoreo de la API y reporte de campeones consultados desde SQLite.",
  "tags": [
    "MundialNube",
    "torneos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Estado de la API",
      "description": "1: disponible; 0: Prometheus no puede consultar la API.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"mundial-api\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No disponible",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Torneos registrados",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mundial_tournaments_total{job=\"mundial-api\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Campeones registrados",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mundial_champions_total{job=\"mundial-api\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Errores HTTP (5xx / segundo)",
      "description": "",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_received_total{job=\"mundial-api\",code=~\"5..\"}[$__rate_interval])) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Sin datos"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Último equipo campeón",
      "description": "Datos guardados en SQLite, actualizados cada 15 segundos. Sin filas hasta registrar un campeón.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mundial_latest_champion_info{job=\"mundial-api\"} == 1",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "team_name": 0,
              "tournament_name": 1
            },
            "renameByName": {
              "team_name": "Equipo campeón",
              "tournament_name": "Torneo"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "Sin campeones registrados"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "title": "Últimos 20 campeones · más reciente primero",
      "description": "Datos guardados en SQLite, actualizados cada 15 segundos. Sin filas hasta registrar un campeón.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mundial_recent_champion_info{job=\"mundial-api\"} == 1",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "rank",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "rank": 0,
              "team_name": 1,
              "tournament_name": 2,
              "completed_at": 3
            },
            "renameByName": {
              "rank": "Posición",
              "team_name": "Equipo campeón",
              "tournament_name": "Torneo",
              "completed_at": "Finalizado (UTC)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Posición",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "noValue": "Sin campeones registrados"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(http_requests_received_total{job=\"mundial-api\"}[$__rate_interval]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Tiempo de respuesta · percentil 95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mundial-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"mundial-api\"}[$__rate_interval])))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "mundial-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": []
}
